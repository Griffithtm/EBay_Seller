@model CloneEbay.Web.Models.ConversationViewModel
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "Chat với " + Model.OtherUsername;
    var apiUrl = Configuration["Api:PublicBaseUrl"];
    var accessToken = HttpContextAccessor.HttpContext?.Request.Cookies["cloneebay.api.access"];
}

<style>
    .chat-container { height: 85vh; }
    #chatHistory { background-color: #ffffff; }
    
    .message-row { display: flex; margin-bottom: 2px; }
    .message-row.received { justify-content: flex-start; padding-right: 20%; }
    .message-row.sent { justify-content: flex-end; padding-left: 20%; }
    
    /* Khoảng cách giữa các tin nhắn của những người khác nhau */
    .message-group-start { margin-top: 8px; }
    
    .chat-bubble {
        padding: 8px 12px;
        border-radius: 18px;
        word-wrap: break-word;
        font-size: 0.95rem;
        display: inline-block;
        max-width: 100%;
    }
    
    .chat-bubble-text {
        white-space: pre-wrap;
    }
    
    .chat-received {
        background-color: #e4e6eb;
        color: #050505;
    }
    
    .chat-sent {
        background-color: #0084ff;
        color: #ffffff;
    }
    
    .chat-time {
        font-size: 0.7rem;
        color: #8e8e8e;
        margin-top: 2px;
        margin-bottom: 8px;
        display: flex;
        align-items: center;
    }
    .message-row.sent .chat-time { justify-content: flex-end; }
    
    .avatar-sm {
        width: 28px;
        height: 28px;
        flex-shrink: 0;
        margin-right: 8px;
        border-radius: 50%;
        align-self: flex-end; /* Avatar ở dưới cùng như Messenger */
    }
    .avatar-placeholder {
        width: 28px;
        margin-right: 8px;
        flex-shrink: 0;
    }
    
    .input-area {
        background-color: #ffffff;
        border-top: 1px solid #dee2e6;
        padding: 12px 16px;
    }
    .input-box {
        background-color: #f0f2f5;
        border-radius: 20px;
        padding: 4px 16px;
        display: flex;
        align-items: center;
        flex-grow: 1;
    }
    .input-box input {
        border: none;
        background: transparent;
        outline: none;
        box-shadow: none;
        flex-grow: 1;
        padding: 8px 0;
    }
</style>

<div class="container-fluid mt-3 px-4">
    <div class="row border rounded shadow-sm bg-white chat-container">
        <!-- Sidebar -->
        <div class="col-md-4 border-end d-none d-md-flex flex-column p-0 h-100">
            <div class="p-3 border-bottom">
                <h4 class="mb-3 fw-bold">Đoạn chat</h4>
                <div class="input-group">
                    <span class="input-group-text bg-light border-0 rounded-start-pill"><i class="bi bi-search"></i></span>
                    <input type="text" class="form-control bg-light border-0 rounded-end-pill" placeholder="Tìm kiếm...">
                </div>
            </div>
            
            <div class="list-group list-group-flush flex-grow-1 overflow-auto">
                @if (Model.Conversations.Count == 0)
                {
                    <p class="text-muted text-center mt-4">Chưa có cuộc hội thoại nào.</p>
                }
                else
                {
                    foreach (var conv in Model.Conversations)
                    {
                        var isUnread = conv.UnreadCount > 0;
                        var isActive = conv.WithUserId == Model.OtherUserId;
                        <a asp-action="Conversation" asp-route-userId="@conv.WithUserId" data-userid="@conv.WithUserId" class="list-group-item list-group-item-action py-3 border-bottom @(isUnread ? "bg-light" : "") @(isActive ? "active text-white" : "")">
                            <div class="d-flex align-items-center">
                                <img src="https://ui-avatars.com/api/?name=@conv.WithUsername&background=random" class="rounded-circle me-3" style="width: 48px; height: 48px;">
                                <div class="flex-grow-1 overflow-hidden">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <h6 class="mb-0 text-truncate @(isUnread && !isActive ? "fw-bold" : "")">@conv.WithUsername</h6>
                                        <small class="conv-last-time @(isActive ? "text-light" : "text-muted")">@conv.LastMessageAt.ToLocalTime().ToString("dd/MM HH:mm")</small>
                                    </div>
                                    <p class="conv-last-msg mb-0 small text-truncate mt-1 @(isActive ? "text-light" : "text-muted") @(isUnread && !isActive ? "fw-bold text-dark" : "")">
                                        @conv.LastMessage
                                    </p>
                                </div>
                            </div>
                        </a>
                    }
                }
            </div>
        </div>

        <!-- Chat Area -->
        <div class="col-md-8 d-flex flex-column h-100 p-0">
            <!-- Header -->
            <div class="bg-white border-bottom p-3 d-flex align-items-center shadow-sm z-1">
                <a asp-action="Index" class="btn btn-sm btn-light me-3 d-md-none rounded-circle"><i class="bi bi-chevron-left"></i></a>
                <img src="https://ui-avatars.com/api/?name=@Model.OtherUsername&background=random" class="rounded-circle me-3" style="width: 40px; height: 40px;">
                <h5 class="mb-0 fw-bold">@Model.OtherUsername</h5>
                <button class="btn btn-light ms-auto rounded-circle"><i class="bi bi-three-dots"></i></button>
            </div>

            <!-- Messages -->
            <div id="chatHistory" class="flex-grow-1 p-3 overflow-auto d-flex flex-column-reverse">
                @for (int i = 0; i < Model.Messages.Count; i++)
                {
                    var msg = Model.Messages[i];
                    bool isReceived = msg.SenderId == Model.OtherUserId;
                    bool isLastInGroup = i == 0 || Model.Messages[i - 1].SenderId != msg.SenderId;
                    bool isFirstInGroup = i == Model.Messages.Count - 1 || Model.Messages[i + 1].SenderId != msg.SenderId;

                    <div class="message-row @(isReceived ? "received" : "sent") @(isFirstInGroup ? "message-group-start" : "")">
                        @if (isReceived)
                        {
                            if (isLastInGroup)
                            {
                                <img src="https://ui-avatars.com/api/?name=@Model.OtherUsername&background=random" class="avatar-sm">
                            }
                            else
                            {
                                <div class="avatar-placeholder"></div>
                            }
                        }
                        
                        <div class="d-flex flex-column @(isReceived ? "align-items-start" : "align-items-end") w-100">
                            <div class="chat-bubble @(isReceived ? "chat-received" : "chat-sent")" 
                                 style="@(isReceived ? (isFirstInGroup ? "border-top-left-radius: 18px;" : "border-top-left-radius: 4px;") + (isLastInGroup ? "border-bottom-left-radius: 18px;" : "border-bottom-left-radius: 4px;") : (isFirstInGroup ? "border-top-right-radius: 18px;" : "border-top-right-radius: 4px;") + (isLastInGroup ? "border-bottom-right-radius: 18px;" : "border-bottom-right-radius: 4px;"))">
                                @if (msg.RelatedProductId.HasValue)
                                {
                                    <div class="card mb-2" style="width: 16rem; max-width: 100%;">
                                      <div class="card-body p-2">
                                        <h6 class="card-subtitle mb-0 text-dark">Sản phẩm đính kèm (ID: @msg.RelatedProductId)</h6>
                                      </div>
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(msg.AttachmentUrl))
                                {
                                    <img src="@msg.AttachmentUrl" class="img-fluid rounded mb-2" style="max-height: 200px; display: block;" />
                                }
                                <span class="chat-bubble-text">@msg.Content</span>
                            </div>
                            @if (isLastInGroup)
                            {
                                <div class="chat-time">
                                    @msg.Timestamp.ToLocalTime().ToString("HH:mm")
                                    @if (!isReceived)
                                    {
                                        <i class="bi bi-check2-all text-primary ms-1" style="font-size: 1.1em;"></i>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>

            <!-- Input -->
            <div class="input-area">
                <form id="sendMessageForm" class="d-flex align-items-center">
                    <input type="hidden" id="receiverId" value="@Model.OtherUserId" />
                    
                    <input type="file" id="imageInput" accept="image/jpeg,image/png,image/webp" hidden />
                    <button type="button" id="btnUploadImage" class="btn btn-light rounded-circle text-primary me-2 shadow-sm" style="width: 40px; height: 40px; padding: 0;"><i class="bi bi-image"></i></button>
                    <button type="button" class="btn btn-light rounded-circle text-primary me-2 shadow-sm" style="width: 40px; height: 40px; padding: 0;"><i class="bi bi-box-seam"></i></button>
                    
                    <div class="input-box mx-1 d-flex flex-column" style="position: relative;">
                        <div id="imagePreviewContainer" class="d-none w-100 mb-2">
                            <div class="position-relative d-inline-block">
                                <img id="imagePreview" src="" style="max-height: 100px; border-radius: 8px;" />
                                <button type="button" id="btnRemoveImage" class="btn btn-sm btn-danger rounded-circle position-absolute top-0 start-100 translate-middle" style="width: 24px; height: 24px; padding: 0; line-height: 1;"><i class="bi bi-x"></i></button>
                            </div>
                        </div>
                        <input type="text" id="messageInput" placeholder="Nhập tin nhắn..." autocomplete="off">
                    </div>
                    
                    <button type="submit" class="btn btn-primary rounded-circle shadow-sm flex-shrink-0 ms-2" style="width: 40px; height: 40px; padding: 0; display: flex; align-items: center; justify-content: center;">
                        <i class="bi bi-send-fill" style="margin-left: -2px; font-size: 1.1rem;"></i>
                    </button>
                </form>
            </div>
            
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', async function () {
            const receiverId = document.getElementById('receiverId').value;
            const messageInput = document.getElementById('messageInput');
            const chatHistory = document.getElementById('chatHistory');
            const sendForm = document.getElementById('sendMessageForm');
            const imageInput = document.getElementById('imageInput');
            const btnUploadImage = document.getElementById('btnUploadImage');
            const imagePreviewContainer = document.getElementById('imagePreviewContainer');
            const imagePreview = document.getElementById('imagePreview');
            const btnRemoveImage = document.getElementById('btnRemoveImage');
            
            const otherUsername = '@Model.OtherUsername';
            const accessToken = '@accessToken';
            
            let pendingAttachmentUrl = null;

            // Function to add bubble to UI
            function addMessageBubble(content, timeStr, isReceived, attachmentUrl = null) {
                const row = document.createElement('div');
                row.className = "message-row message-group-start " + (isReceived ? "received" : "sent");
                
                let avatarHtml = '';
                if (isReceived) {
                    avatarHtml = `<img src="https://ui-avatars.com/api/?name=${otherUsername}&background=random" class="avatar-sm">`;
                }
                
                let checkHtml = isReceived ? '' : `<i class="bi bi-check2-all text-primary ms-1" style="font-size: 1.1em;"></i>`;
                let bubbleClass = isReceived ? "chat-received" : "chat-sent";
                let alignClass = isReceived ? "align-items-start" : "align-items-end";
                
                let attachmentHtml = '';
                if (attachmentUrl) {
                    attachmentHtml = `<img src="${attachmentUrl}" class="img-fluid rounded mb-2" style="max-height: 200px; display: block;" />`;
                }

                row.innerHTML = `
                    ${avatarHtml}
                    <div class="d-flex flex-column ${alignClass} w-100">
                        <div class="chat-bubble ${bubbleClass}">
                            ${attachmentHtml}
                            <span class="chat-bubble-text">${content}</span>
                        </div>
                        <div class="chat-time">
                            ${timeStr} ${checkHtml}
                        </div>
                    </div>`;
                chatHistory.prepend(row);
            }

            // SignalR Connection
            const connection = new signalR.HubConnectionBuilder()
                .withUrl(`@apiUrl/hubs/messages?access_token=${accessToken}`)
                .withAutomaticReconnect()
                .build();

            connection.on("messageReceived", function (message) {
                const sender = message.senderId || message.SenderId;
                const content = message.content || message.Content;
                const timestamp = message.timestamp || message.Timestamp;
                const attachmentUrl = message.attachmentUrl || message.AttachmentUrl;
                
                const d = new Date(timestamp);
                const time = d.getHours().toString().padStart(2, '0') + ':' + d.getMinutes().toString().padStart(2, '0');
                const sidebarTime = d.getDate().toString().padStart(2, '0') + '/' + (d.getMonth()+1).toString().padStart(2, '0') + ' ' + time;

                if (sender == receiverId) {
                    addMessageBubble(content, time, true, attachmentUrl);
                }

                // Update sidebar
                const convItem = document.querySelector(`[data-userid="${sender}"]`);
                if (convItem) {
                    convItem.querySelector('.conv-last-msg').textContent = content || "[Hình ảnh]";
                    convItem.querySelector('.conv-last-time').textContent = sidebarTime;
                    
                    if (sender != receiverId) {
                        convItem.classList.add('bg-light');
                        convItem.querySelector('h6').classList.add('fw-bold');
                        convItem.querySelector('.conv-last-msg').classList.add('fw-bold', 'text-dark');
                    }
                    
                    const list = convItem.parentElement;
                    list.prepend(convItem);
                }
            });

            try {
                await connection.start();
                console.log("SignalR connected.");
            } catch (err) {
                console.error("SignalR error: ", err);
            }

            // --- File Upload Logic ---
            btnUploadImage.addEventListener('click', () => {
                imageInput.click();
            });

            btnRemoveImage.addEventListener('click', () => {
                pendingAttachmentUrl = null;
                imagePreview.src = '';
                imagePreviewContainer.classList.add('d-none');
                imageInput.value = '';
            });

            imageInput.addEventListener('change', async function () {
                const file = this.files[0];
                if (!file) return;

                const formData = new FormData();
                formData.append('file', file);

                try {
                    const btn = btnUploadImage;
                    const oldHtml = btn.innerHTML;
                    btn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>';
                    btn.disabled = true;

                    const res = await fetch('/Messages/UploadAttachment', {
                        method: 'POST',
                        body: formData
                    });

                    if (res.ok) {
                        const data = await res.json();
                        pendingAttachmentUrl = data.url;
                        imagePreview.src = data.url;
                        imagePreviewContainer.classList.remove('d-none');
                    } else {
                        alert("Lỗi upload ảnh.");
                    }
                    
                    btn.innerHTML = oldHtml;
                    btn.disabled = false;
                } catch(e) {
                    console.error("Upload error", e);
                }
            });
            // --------------------------

            sendForm.addEventListener('submit', async function (e) {
                e.preventDefault();
                const content = messageInput.value.trim();
                
                // If there's no text AND no attachment, do nothing.
                if (!content && !pendingAttachmentUrl) return;

                messageInput.value = ''; 
                
                const attachmentUrlToSend = pendingAttachmentUrl;
                
                // Clear UI
                btnRemoveImage.click();

                const d = new Date();
                const time = d.getHours().toString().padStart(2, '0') + ':' + d.getMinutes().toString().padStart(2, '0');
                addMessageBubble(content, time, false, attachmentUrlToSend);

                // Update sidebar for sent message
                const convItem = document.querySelector(`[data-userid="${receiverId}"]`);
                if (convItem) {
                    convItem.querySelector('.conv-last-msg').textContent = content || "[Hình ảnh]";
                    convItem.querySelector('.conv-last-time').textContent = d.getDate().toString().padStart(2, '0') + '/' + (d.getMonth()+1).toString().padStart(2, '0') + ' ' + time;
                    const list = convItem.parentElement;
                    list.prepend(convItem);
                }

                try {
                    await fetch('/Messages/Send', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ 
                            ReceiverId: parseInt(receiverId), 
                            Content: content,
                            AttachmentUrl: attachmentUrlToSend
                        })
                    });
                } catch(err) {
                    console.error(err);
                }
            });
        });
    </script>
}

