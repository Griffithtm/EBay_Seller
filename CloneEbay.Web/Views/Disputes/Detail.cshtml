@model DisputeResponseDto
@{
    ViewData["Title"] = $"Chi tiết Tranh chấp #{Model.Id}";
}

<div class="page-breadcrumb reveal"><a asp-controller="Seller" asp-action="Index">Seller Center</a><span>›</span><a asp-action="Index">Tranh chấp</a><span>›</span><strong>#@Model.Id</strong></div>

<section class="catalog-hero reveal">
    <div>
        <span class="section-kicker">DISPUTE DETAILS</span>
        <h1>Tranh chấp đơn hàng #@Model.OrderId</h1>
        <p>Người tạo: <strong>@Model.RaiserUsername</strong> | Ngày tạo: @Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p>
    </div>
</section>

<section class="catalog-workspace reveal reveal-delay-1 mt-4">
    <div class="row g-4">
        <div class="col-md-8">
            <div class="card mb-4">
                <div class="card-header bg-light d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Nội dung Tranh chấp</h5>
                    <span class="badge @(Model.Status switch { "Resolved" => "bg-success", "Escalated" => "bg-danger", "UnderReview" => "bg-info", _ => "bg-primary" })">@Model.Status</span>
                </div>
                <div class="card-body">
                    <p class="card-text">@Model.Description</p>
                    @if (Model.Resolution != null)
                    {
                        <div class="alert alert-success mt-3 mb-0">
                            <strong>Kết quả giải quyết:</strong> @Model.Resolution
                        </div>
                    }
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Lịch sử Trao đổi & Tin nhắn</h5>
                </div>
                <div class="card-body" style="max-height: 400px; overflow-y: auto;">
                    @if (Model.Messages.Count == 0)
                    {
                        <p class="text-muted text-center py-3">Chưa có tin nhắn trao đổi nào.</p>
                    }
                    else
                    {
                        foreach (var msg in Model.Messages)
                        {
                            <div class="mb-3 p-3 rounded-3 @(msg.SenderRole == "Seller" ? "bg-primary-subtle text-end ms-5" : "bg-light me-5") border">
                                <div class="small fw-bold text-muted mb-1">
                                    @msg.SenderUsername (@msg.SenderRole) • @msg.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                </div>
                                <div>@msg.Message</div>
                            </div>
                        }
                    }
                </div>
                @if (Model.Status != "Resolved" && Model.Status != "Closed")
                {
                    <div class="card-footer bg-white">
                        <form asp-action="Respond" method="post">
                            <input type="hidden" name="id" value="@Model.Id" />
                            <div class="input-group">
                                <input type="text" name="message" class="form-control" placeholder="Nhập tin nhắn trao đổi..." required />
                                <button type="submit" class="btn btn-primary">Gửi tin nhắn</button>
                            </div>
                        </form>
                    </div>
                }
            </div>
        </div>

        <div class="col-md-4">
            <div class="card mb-4">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Bằng chứng & Tài liệu đính kèm</h5>
                </div>
                <div class="card-body">
                    @if (Model.Evidences.Count == 0)
                    {
                        <p class="text-muted small">Chưa có bằng chứng nào được tải lên.</p>
                    }
                    else
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var ev in Model.Evidences)
                            {
                                <li class="list-group-flush py-2 d-flex justify-content-between align-items-center">
                                    <div>
                                        <a href="@ev.FilePath" target="_blank" class="fw-bold text-truncate d-block" style="max-width: 180px;">📄 @ev.FileName</a>
                                        <small class="text-muted d-block">Bởi: @ev.UploaderUsername</small>
                                    </div>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>

            @if (Model.Status != "Resolved" && Model.Status != "Closed")
            {
                <div class="card">
                    <div class="card-header bg-light">
                        <h5 class="mb-0">Thao tác Tranh chấp</h5>
                    </div>
                    <div class="card-body d-grid gap-2">
                        @if (Model.Status != "Escalated")
                        {
                            <form asp-action="Escalate" method="post" class="d-grid">
                                <input type="hidden" name="id" value="@Model.Id" />
                                <button type="submit" class="btn btn-warning" onclick="return confirm('Bạn có chắc muốn leo thang tranh chấp này lên Admin xử lý?')">⚠️ Leo thang cho Admin</button>
                            </form>
                        }

                        <hr />

                        <form asp-action="Resolve" method="post">
                            <input type="hidden" name="id" value="@Model.Id" />
                            <div class="mb-2">
                                <label class="form-label small fw-bold">Nhập kết quả giải quyết:</label>
                                <textarea name="resolution" class="form-control form-control-sm" rows="3" placeholder="Ghi rõ phương án giải quyết (ví dụ: Đồng ý hoàn lại 50% tiền...)" required></textarea>
                            </div>
                            <button type="submit" class="btn btn-success w-100">✔ Xác nhận Giải quyết</button>
                        </form>
                    </div>
                </div>
            }
        </div>
    </div>
</section>
