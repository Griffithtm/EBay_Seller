                provinces: {
                    "California": ["Los Angeles County", "Orange County", "San Diego County", "Santa Clara County", "San Francisco County", "Alameda County"],
                    "New York": ["New York County (Manhattan)", "Kings County (Brooklyn)", "Queens County", "Bronx County", "Richmond County (Staten Island)"],
