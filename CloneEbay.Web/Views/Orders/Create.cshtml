                }
            },
            "Japan": {
                defaultZip: "100-0001",
                provinces: {
                    "Tokyo": ["Chiyoda-ku", "Shinjuku-ku", "Shibuya-ku", "Minato-ku", "Chuo-ku", "Toshima-ku", "Setagaya-ku"],
                    "Osaka": ["Kita-ku", "Chuo-ku", "Naniwa-ku", "Tennoji-ku", "Yodogawa-ku"],
                    "Kanagawa": ["Yokohama City", "Kawasaki City", "Kamakura City", "Sagamihara City"],
                    "Aichi": ["Nagoya City", "Toyota City", "Okazaki City", "Ichinomiya City"],
                    "Kyoto": ["Kyoto City", "Uji City", "Kameoka City", "Maizuru City"]
                }
            },
            "United Kingdom": {
                defaultZip: "SW1A 1AA",
                provinces: {
                    "Greater London": ["City of Westminster", "Camden", "Kensington and Chelsea", "Islington", "Southwark", "Greenwich"],
                    "Greater Manchester": ["Manchester", "Salford", "Trafford", "Bolton", "Stockport"],
                    "West Midlands": ["Birmingham", "Coventry", "Wolverhampton", "Solihull", "Walsall"]
                }
            },
            "Australia": {
                defaultZip: "2000",
                provinces: {
                    "New South Wales": ["City of Sydney", "Parramatta", "North Sydney", "Canterbury-Bankstown", "Blacktown"],
                    "Victoria": ["City of Melbourne", "Yarra", "Port Phillip", "Monash", "Boroondara"],
                    "Queensland": ["City of Brisbane", "Gold Coast", "Sunshine Coast", "Cairns", "Townsville"]
                }
            },
            "Germany": {
                defaultZip: "10115",
                provinces: {
                    "Berlin": ["Mitte", "Charlottenburg-Wilmersdorf", "Friedrichshain-Kreuzberg", "Pankow"],
                    "Bavaria": ["Munich", "Nuremberg", "Augsburg", "Regensburg", "Ingolstadt"],
                    "North Rhine-Westphalia": ["Cologne", "Düsseldorf", "Dortmund", "Essen", "Bonn"]
                }
            },
            "France": {
                defaultZip: "75001",
                provinces: {
                    "Île-de-France": ["Paris 1er", "Paris 8e", "Paris 16e", "Boulogne-Billancourt", "Saint-Denis"],
                    "Auvergne-Rhône-Alpes": ["Lyon", "Grenoble", "Saint-Étienne", "Annecy"],
                    "Provence-Alpes-Côte d'Azur": ["Marseille", "Nice", "Toulon", "Aix-en-Provence", "Cannes"]
                }
            },
            "Canada": {
                defaultZip: "M5H 2N2",
                provinces: {
                    "Ontario": ["City of Toronto", "Ottawa", "Mississauga", "Brampton", "Hamilton"],
                    "British Columbia": ["Vancouver", "Surrey", "Burnaby", "Richmond", "Victoria"],
                    "Quebec": ["Montreal", "Quebec City", "Laval", "Gatineau", "Longueuil"]
                }
            },
            "South Korea": {
                defaultZip: "04524",
                provinces: {
                    "Seoul": ["Gangnam-gu", "Jung-gu", "Mapo-gu", "Seocho-gu", "Songpa-gu", "Yongsan-gu"],
                    "Busan": ["Haeundae-gu", "Busanjin-gu", "Jung-gu", "Suyeong-gu"],
                    "Gyeonggi-do": ["Suwon-si", "Seongnam-si (Bundang)", "Yongin-si", "Goyang-si"]
                }
            },
            "Singapore": {
                defaultZip: "018989",
                provinces: {
                    "Central Region": ["Downtown Core", "Orchard", "Marina South", "Newton", "Novena", "Queenstown"],
                    "East Region": ["Bedok", "Changi", "Pasir Ris", "Tampines"],
                    "West Region": ["Jurong East", "Jurong West", "Clementi", "Bukit Batok"]
                }
            }
        };

        document.addEventListener('DOMContentLoaded', function () {
            // Price calculation references
            const productSelect = document.getElementById('productSelect');
            const quantityInput = document.getElementById('quantityInput');
            const unitPriceInput = document.getElementById('unitPriceInput');

            const summaryQty = document.getElementById('summaryQty');
            const summaryUnitPrice = document.getElementById('summaryUnitPrice');
            const summaryTotal = document.getElementById('summaryTotal');
            const summaryFvf = document.getElementById('summaryFvf');
            const summaryNet = document.getElementById('summaryNet');

            // Location selectors
            const countrySelect = document.getElementById('countrySelect');
            const provinceSelect = document.getElementById('provinceSelect');
            const districtSelect = document.getElementById('districtSelect');
            const zipCodeInput = document.getElementById('zipCodeInput');

            function populateProvinces() {
                const country = countrySelect.value;
                const countryData = LOCATION_DATA[country] || LOCATION_DATA["Vietnam"];
                
                provinceSelect.innerHTML = "";
                for (const prov in countryData.provinces) {
                    const opt = document.createElement("option");
                    opt.value = prov;
                    opt.textContent = prov;
                    provinceSelect.appendChild(opt);
                }

                if (countryData.defaultZip) {
                    zipCodeInput.value = countryData.defaultZip;
                }

                populateDistricts();
            }

            function populateDistricts() {
                const country = countrySelect.value;
                const prov = provinceSelect.value;
                const countryData = LOCATION_DATA[country] || LOCATION_DATA["Vietnam"];
                const districts = (countryData.provinces && countryData.provinces[prov]) ? countryData.provinces[prov] : ["Khu vực Trung tâm", "Quận 1", "Quận 2"];

                districtSelect.innerHTML = "";
                districts.forEach(function (dist) {
                    const opt = document.createElement("option");
                    opt.value = dist;
                    opt.textContent = dist;
                    districtSelect.appendChild(opt);
                });
            }

            countrySelect.addEventListener('change', populateProvinces);
            provinceSelect.addEventListener('change', populateDistricts);

            // Initialize location dropdowns
            populateProvinces();
            const unitPriceDisplay = document.getElementById('unitPriceDisplay');

            function updateCalculation() {
                const selectedOpt = productSelect.options[productSelect.selectedIndex];
                let price = 0;

                if (selectedOpt && selectedOpt.value) {
                    price = parseFloat(selectedOpt.getAttribute('data-price')) || 0;
                }

                const qty = parseInt(quantityInput.value) || 1;
                const total = price * qty;
                const fvf = Math.round(total * 0.10);
                const net = total - fvf;

                unitPriceDisplay.value = price.toLocaleString('vi-VN') + ' VNĐ';
                summaryQty.textContent = qty;
                summaryUnitPrice.textContent = price.toLocaleString('vi-VN') + ' VNĐ';
                summaryTotal.textContent = total.toLocaleString('vi-VN') + ' VNĐ';
                summaryFvf.textContent = '-' + fvf.toLocaleString('vi-VN') + ' VNĐ';
                summaryNet.textContent = net.toLocaleString('vi-VN') + ' VNĐ';
            }

            productSelect.addEventListener('change', updateCalculation);
            quantityInput.addEventListener('input', updateCalculation);

            updateCalculation();

            // Dynamic submit button based on selected payment gateway
            const btnSubmitOrder = document.getElementById('btnSubmitOrder');
            const btnSubmitText = document.getElementById('btnSubmitText');
            const btnSubmitIcon = document.getElementById('btnSubmitIcon');
            const paymentRadios = document.querySelectorAll('input[name="PaymentMethod"]');

            function updatePaymentButton() {
                let selectedPayment = "Pay Cash on Delivery (COD)";
                paymentRadios.forEach(function(r) {
                    if (r.checked) selectedPayment = r.value;
                });

                if (selectedPayment.includes("VNPay")) {
                    btnSubmitText.textContent = "Chuyển đến Trang VNPay Sandbox Test";
                    btnSubmitIcon.className = "bi bi-wallet2 me-2";
                    btnSubmitOrder.style.background = "#005baa";
                    btnSubmitOrder.style.borderColor = "#005baa";
                    btnSubmitOrder.style.color = "#ffffff";
                } else if (selectedPayment.includes("PayPal")) {
                    btnSubmitText.textContent = "Chuyển đến Trang PayPal Sandbox Test";
                    btnSubmitIcon.className = "bi bi-paypal me-2";
                    btnSubmitOrder.style.background = "#ffc439";
                    btnSubmitOrder.style.borderColor = "#ffc439";
                    btnSubmitOrder.style.color = "#000000";
                } else {
                    btnSubmitText.textContent = "Tạo Đơn Hàng & Đồng Bộ Kho (COD)";
                    btnSubmitIcon.className = "bi bi-check-circle me-2";
                    btnSubmitOrder.style.background = "#0064d2";
                    btnSubmitOrder.style.borderColor = "#0064d2";
                    btnSubmitOrder.style.color = "#ffffff";
                }
            }

            paymentRadios.forEach(function(r) {
                r.addEventListener('change', updatePaymentButton);
            });

            updatePaymentButton();
        });
    </script>
}
