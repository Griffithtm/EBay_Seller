@model CreateManualOrderViewModel
@{
    ViewData["Title"] = "Ghi nhận Đơn hàng Ngoài sàn · eBay Seller Hub";
    var products = ViewBag.Products as IReadOnlyList<ProductDto> ?? [];
}

<div class="page-breadcrumb reveal">
    <a asp-controller="Home" asp-action="Index">eBay Seller Hub</a>
    <span>›</span>
    <a asp-controller="Orders" asp-action="Index">Orders &amp; Shipping</a>
    <span>›</span>
    <strong>Create Invoice &amp; Manual Order</strong>
</div>

<section class="catalog-hero reveal mb-4">
    <div>
        <span class="section-kicker" style="background:#0064d2;color:#fff;font-weight:bold;padding:4px 10px;border-radius:4px;font-size:0.75rem;">EBAY SELLER HUB</span>
        <h1 class="mt-2">Ghi nhận Đơn hàng Ngoài sàn</h1>
    </div>
</section>

@if (TempData["ErrorMessage"] is string error)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@error
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row g-4 reveal">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0 rounded-4 p-4">
            <form asp-action="Create" method="post" id="manualOrderForm">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <!-- SECTION 1: SẢN PHẨM & GIÁ -->
                <div class="d-flex align-items-center mb-3">
                    <span class="badge rounded-circle bg-primary me-2 p-2" style="width: 28px; height: 28px; display: inline-flex; align-items: center; justify-content: center;">1</span>
                    <h5 class="fw-bold mb-0 text-primary">Thông tin Sản phẩm &amp; Giá bán</h5>
                </div>
                
                <div class="mb-3">
                    <label asp-for="ProductId" class="form-label fw-bold">Chọn sản phẩm trong kho của bạn <span class="text-danger">*</span></label>
                    <select asp-for="ProductId" class="form-select form-select-lg" id="productSelect" required>
                        <option value="">-- Chọn sản phẩm đăng bán --</option>
                        @foreach (var p in products)
                        {
                            var stock = p.Inventory?.Quantity ?? 0;
                            var isOut = stock <= 0;
                            <option value="@p.Id" data-price="@p.Price" data-stock="@stock" disabled="@(isOut ? "disabled" : null)">
                                @p.Title - @p.Price.ToString("N0") VNĐ @(isOut ? "(⚠️ HẾT HÀNG)" : $"(Tồn kho: {stock})")
                            </option>
                        }
                    </select>
                    <span asp-validation-for="ProductId" class="text-danger small"></span>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label asp-for="Quantity" class="form-label fw-bold">Số lượng mua <span class="text-danger">*</span></label>
                        <input asp-for="Quantity" type="number" min="1" class="form-control form-control-lg" id="quantityInput" value="1" required />
                        <span asp-validation-for="Quantity" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Đơn giá niêm yết sản phẩm</label>
                        <input type="text" class="form-control form-control-lg bg-light" id="unitPriceDisplay" value="0 VNĐ" readonly />
                    </div>
                </div>

                <hr class="my-4" />

                <!-- SECTION 2: ĐỊA CHỈ & NGƯỜI MUA (CASCADING LOCATION LIBRARY) -->
                <div class="d-flex align-items-center mb-3">
                    <span class="badge rounded-circle bg-primary me-2 p-2" style="width: 28px; height: 28px; display: inline-flex; align-items: center; justify-content: center;">2</span>
                    <h5 class="fw-bold mb-0 text-primary">Địa chỉ Giao hàng Quốc tế &amp; Trong nước (Đồng bộ thư viện)</h5>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="BuyerFullName" class="form-label fw-bold">Họ &amp; Tên người nhận <span class="text-danger">*</span></label>
                        <input asp-for="BuyerFullName" class="form-control" placeholder="Nhập họ và tên người nhận" required />
                        <span asp-validation-for="BuyerFullName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="BuyerPhone" class="form-label fw-bold">Số điện thoại liên hệ <span class="text-danger">*</span></label>
                        <input asp-for="BuyerPhone" class="form-control" placeholder="Nhập số điện thoại" required />
                        <span asp-validation-for="BuyerPhone" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label asp-for="Country" class="form-label fw-bold">Quốc gia <span class="text-danger">*</span></label>
                        <select asp-for="Country" class="form-select" id="countrySelect" required>
                            <option value="Vietnam">Vietnam (Việt Nam)</option>
                            <option value="United States">United States (Hoa Kỳ)</option>
                            <option value="Japan">Japan (Nhật Bản)</option>
                            <option value="United Kingdom">United Kingdom (Vương quốc Anh)</option>
                            <option value="Australia">Australia (Úc)</option>
                            <option value="Germany">Germany (Đức)</option>
                            <option value="France">France (Pháp)</option>
                            <option value="Canada">Canada</option>
                            <option value="South Korea">South Korea (Hàn Quốc)</option>
                            <option value="Singapore">Singapore</option>
                        </select>
                        <span asp-validation-for="Country" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="City" class="form-label fw-bold">Tỉnh / Thành phố <span class="text-danger">*</span></label>
                        <select asp-for="City" class="form-select" id="provinceSelect" required>
                            <!-- Populated dynamically via JS Location Library -->
                        </select>
                        <span asp-validation-for="City" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="District" class="form-label fw-bold">Quận / Huyện <span class="text-danger">*</span></label>
                        <select asp-for="District" class="form-select" id="districtSelect" required>
                            <!-- Populated dynamically via JS Location Library -->
                        </select>
                        <span asp-validation-for="District" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-md-8">
                        <label asp-for="Street" class="form-label fw-bold">Số nhà, Tên đường, Tòa nhà / Phường Xã <span class="text-danger">*</span></label>
                        <input asp-for="Street" class="form-control" placeholder="Số nhà, tên đường, tòa nhà / Phường Xã" required />
                        <span asp-validation-for="Street" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="ZipCode" class="form-label fw-bold">Mã bưu chính (Postal / Zip)</label>
                        <input asp-for="ZipCode" class="form-control" id="zipCodeInput" placeholder="Mã bưu chính" />
                        <span asp-validation-for="ZipCode" class="text-danger small"></span>
                    </div>
                </div>

                <hr class="my-4" />

                <!-- SECTION 3: PHƯƠNG THỨC THANH TOÁN (3 OPTIONS ONLY) -->
                <div class="d-flex align-items-center mb-3">
                    <span class="badge rounded-circle bg-primary me-2 p-2" style="width: 28px; height: 28px; display: inline-flex; align-items: center; justify-content: center;">3</span>
                    <h5 class="fw-bold mb-0 text-primary">Phương thức Thanh toán</h5>
                </div>

                <div class="mb-4">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="card p-3 border rounded-3 h-100 cursor-pointer payment-card text-center d-flex flex-column align-items-center justify-content-center" for="payCod">
                                <input type="radio" asp-for="PaymentMethod" value="Pay Cash on Delivery (COD)" id="payCod" name="PaymentMethod" class="form-check-input mb-2" checked />
                                <div class="fw-bold text-dark fs-6"><i class="bi bi-cash-stack text-success me-1"></i>Pay Cash on Delivery (COD)</div>
                            </label>
                        </div>
                        <div class="col-md-4">
                            <label class="card p-3 border rounded-3 h-100 cursor-pointer payment-card text-center d-flex flex-column align-items-center justify-content-center" for="payVnPay">
                                <input type="radio" asp-for="PaymentMethod" value="VNPay Sandbox Gateway" id="payVnPay" name="PaymentMethod" class="form-check-input mb-2" />
                                <div class="fw-bold text-dark fs-6"><i class="bi bi-wallet2 text-primary me-1"></i>VNPay Sandbox</div>
                            </label>
                        </div>
                        <div class="col-md-4">
                            <label class="card p-3 border rounded-3 h-100 cursor-pointer payment-card text-center d-flex flex-column align-items-center justify-content-center" for="payPayPal">
                                <input type="radio" asp-for="PaymentMethod" value="PayPal Sandbox Gateway" id="payPayPal" name="PaymentMethod" class="form-check-input mb-2" />
                                <div class="fw-bold text-dark fs-6"><i class="bi bi-paypal text-info me-1"></i>PayPal Sandbox</div>
                            </label>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary px-4">Quay lại danh sách</a>
                    <button type="submit" id="btnSubmitOrder" class="btn btn-primary btn-lg px-5 fw-bold" style="background:#0064d2;border-color:#0064d2;">
                        <i class="bi bi-check-circle me-2" id="btnSubmitIcon"></i><span id="btnSubmitText">Tạo Đơn Hàng &amp; Đồng Bộ Kho</span>
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- TÓM TẮT ĐƠN HÀNG -->
    <div class="col-lg-4">
        <div class="card shadow-sm border-0 rounded-4 p-4 sticky-top" style="top: 90px; background: #f8fafc;">
            <h5 class="fw-bold text-dark mb-3"><i class="bi bi-receipt me-2 text-primary"></i>eBay Order Summary</h5>
            
            <div class="d-flex justify-content-between mb-2">
                <span class="text-muted">Số lượng đặt:</span>
                <span class="fw-bold text-dark" id="summaryQty">1</span>
            </div>
            <div class="d-flex justify-content-between mb-2">
                <span class="text-muted">Đơn giá:</span>
                <span class="fw-bold text-dark" id="summaryUnitPrice">0 VNĐ</span>
            </div>
            <hr class="my-2" />
            <div class="d-flex justify-content-between mb-2">
                <span class="fw-bold text-dark">Tổng giá trị đơn:</span>
                <span class="fw-bold text-primary fs-5" id="summaryTotal">0 VNĐ</span>
            </div>
            <div class="d-flex justify-content-between mb-2">
                <span class="text-muted small">Phí sàn eBay Final Value Fee (10%):</span>
                <span class="text-danger small fw-bold" id="summaryFvf">-0 VNĐ</span>
            </div>
            <hr class="my-2" />
            <div class="d-flex justify-content-between align-items-center mb-0">
                <span class="fw-bold text-success">Thực nhận (Net Payout):</span>
                <span class="fw-bold text-success fs-5" id="summaryNet">0 VNĐ</span>
            </div>
        </div>
    </div>
</div>

