@model OrderDetailDto
@{
    ViewData["Title"] = $"Chi tiết Đơn hàng #{Model.Id}";

    string StatusBadgeClass(string status) => status switch
    {
        "Pending" => "bg-warning text-dark",
        "Confirmed" => "bg-primary",
        "Shipped" => "bg-info text-dark",
        "Delivered" => "bg-success",
        "Cancelled" => "bg-danger",
        _ => "bg-secondary"
    };

    string StatusLabel(string status) => status switch
    {
        "Pending" => "Chờ xác nhận (Pending)",
        "Confirmed" => "Đã xác nhận (Confirmed)",
        "Shipped" => "Đã giao vận chuyển (Shipped)",
        "Delivered" => "Đã giao thành công (Delivered)",
        "Cancelled" => "Đã hủy (Cancelled)",
        _ => status
    };
}

<div class="page-breadcrumb reveal">
    <a asp-controller="Seller" asp-action="Index">Seller Center</a><span>›</span>
    <a asp-action="Index">Đơn hàng</a><span>›</span>
    <strong>Đơn hàng #@Model.Id</strong>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Đơn hàng #@Model.Id <span class="badge @StatusBadgeClass(Model.Status)">@StatusLabel(Model.Status)</span></h2>
    <a class="btn btn-outline-secondary" asp-action="Index">← Quay lại danh sách</a>
</div>

@if (TempData["ErrorMessage"] is string error)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @error
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["SuccessMessage"] is string success)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @success
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row g-4">
    <!-- Cột trái: Sản phẩm & Thao tác chính -->
    <div class="col-md-8">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-light">
                <h5 class="card-title mb-0">Sản phẩm thuộc cửa hàng của bạn</h5>
            </div>
            <div class="card-body p-0">
                <table class="table align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Sản phẩm</th>
                            <th>Đơn giá</th>
                            <th>Số lượng</th>
                            <th class="text-end">Thành tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.OrderItems)
                        {
                            var total = item.UnitPrice * item.Quantity;
                            <tr>
                                <td><strong>@item.Title</strong> <small class="text-muted">(ID: @item.ProductId)</small></td>
                                <td>@item.UnitPrice.ToString("N0") VNĐ</td>
                                <td>@item.Quantity</td>
                                <td class="text-end font-weight-bold">@total.ToString("N0") VNĐ</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="table-light">
                            <td colspan="3" class="text-end"><strong>Tổng cộng phần Seller:</strong></td>
                            <td class="text-end text-success font-weight-bold fs-5">
                                @Model.OrderItems.Sum(i => i.UnitPrice * i.Quantity).ToString("N0") VNĐ
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>

        <!-- Khối xử lý đơn hàng (Actions) -->
        <div class="card shadow-sm border-primary">
            <div class="card-header bg-primary text-white">
                <h5 class="card-title mb-0">Xử lý &amp; Cập nhật Đơn hàng</h5>
            </div>
            <div class="card-body">
                @if (Model.Status == "Pending" || Model.Status == "WaitingPayment")
                {
                    <div class="p-3 bg-light rounded border">
                        <h6>1. Xác nhận đơn hàng (Trừ tồn kho)</h6>
                        <p class="small text-muted mb-3">Bấm xác nhận để đổi trạng thái đơn sang Confirmed và tự động trừ tồn kho cho sản phẩm.</p>
                        <form asp-action="Confirm" asp-route-id="@Model.Id" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-success">✔ Xác nhận đơn hàng &amp; Trừ tồn kho</button>
                        </form>
                    </div>
                }
                else if (Model.Status == "Confirmed")
                {
                    <div class="p-3 bg-light rounded border mb-3">
                        <h6>2. Tạo phiếu vận chuyển giả lập (Tạo Nhãn)</h6>
                        <p class="small text-muted mb-2">Chọn đơn vị vận chuyển để sinh mã vận đơn. Trạng thái đơn vẫn là <strong>Confirmed</strong>.</p>
                        <form asp-action="CreateShippingLabel" asp-route-id="@Model.Id" method="post" class="row g-2 align-items-center">
                            @Html.AntiForgeryToken()
                            <div class="col-auto">
                                <select name="carrier" class="form-select" required>
                                    <option value="GHN">Giao Hàng Nhanh (GHN)</option>
                                    <option value="GHTK">Giao Hàng Tiết Kiệm (GHTK)</option>
                                    <option value="ViettelPost">Viettel Post</option>
                                    <option value="VNPost">VN Post</option>
                                </select>
                            </div>
                            <div class="col-auto">
                                <button type="submit" class="btn btn-primary">🏷️ Tạo phiếu vận chuyển (LabelCreated)</button>
                            </div>
                        </form>
                    </div>
                }

                @if (Model.Status == "Confirmed" || Model.Status == "Shipped")
                {
                    <div class="p-3 bg-light rounded border">
                        <h6>3. Cập nhật trạng thái vận chuyển (State Machine)</h6>
                        <p class="small text-muted mb-2">Cập nhật đúng theo tiến trình giao hàng thực tế. Khi chọn <strong>HandedToCarrier</strong>, trạng thái đơn sẽ tự động chuyển sang <strong>Shipped</strong>.</p>
                        <form asp-action="UpdateShippingStatus" asp-route-id="@Model.Id" method="post" class="row g-2 align-items-center">
                            @Html.AntiForgeryToken()
                            <div class="col-auto">
                                <select name="status" class="form-select" required>
                                    <option value="">-- Chọn trạng thái mới --</option>
                                    <option value="HandedToCarrier">Đã bàn giao đơn vị vận chuyển (HandedToCarrier -> Shipped)</option>
                                    <option value="InTransit">Đang vận chuyển (InTransit)</option>
                                    <option value="Delivered">Đã giao hàng thành công (Delivered)</option>
                                    <option value="Cancelled">Hủy vận chuyển (Cancelled)</option>
                                </select>
                            </div>
                            <div class="col-auto">
                                <button type="submit" class="btn btn-warning">🚚 Cập nhật vận chuyển</button>
                            </div>
                        </form>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Cột phải: Địa chỉ, Thanh toán, Vận chuyển Read-Only -->
    <div class="col-md-4">
        <!-- Địa chỉ -->
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-light">
                <h6 class="card-title mb-0">📍 Địa chỉ giao hàng</h6>
            </div>
            <div class="card-body">
                @if (Model.Address is not null)
                {
                    <p class="mb-1"><strong>@Model.Address.FullName</strong> (@Model.Address.Phone)</p>
                    <p class="mb-0 text-muted">@Model.Address.Street, @Model.Address.City, @Model.Address.State, @Model.Address.Country</p>
                }
                else
                {
                    <p class="text-muted mb-0">Chưa có thông tin địa chỉ.</p>
                }
            </div>
        </div>

        <!-- Trạng thái Thanh toán (Read-Only) -->
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-light">
                <h6 class="card-title mb-0">💳 Thanh toán (Read-Only)</h6>
            </div>
            <div class="card-body">
                @if (Model.Payment is not null)
                {
                    <p class="mb-1">Trạng thái: <span class="badge bg-success">@Model.Payment.Status</span></p>
                }
                else
                {
                    <p class="text-muted mb-0">Chưa có thông tin thanh toán.</p>
                }
            </div>
        </div>

        <!-- Trạng thái Vận chuyển -->
        <div class="card shadow-sm">
            <div class="card-header bg-light">
                <h6 class="card-title mb-0">🚚 Thông tin Vận chuyển</h6>
            </div>
            <div class="card-body">
                @if (Model.Shipping is not null)
                {
                    <p class="mb-1">Đơn vị: <strong>@Model.Shipping.Carrier</strong></p>
                    <p class="mb-1">Mã vận đơn: <code>@Model.Shipping.TrackingNumber</code></p>
                    <p class="mb-1">Trạng thái: <span class="badge bg-info text-dark">@Model.Shipping.Status</span></p>
                    @if (Model.Shipping.EstimatedArrival.HasValue)
                    {
                        <p class="mb-0 text-muted small">Dự kiến giao: @Model.Shipping.EstimatedArrival.Value.ToLocalTime().ToString("dd/MM/yyyy")</p>
                    }
                }
                else
                {
                    <p class="text-muted mb-0">Chưa sinh phiếu vận chuyển.</p>
                }
            </div>
        </div>
    </div>
</div>
