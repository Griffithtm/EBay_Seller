@model OrderDetailDto
@{
    ViewData["Title"] = "Cổng Thanh toán PayPal Sandbox";
    Layout = null;
    var usdAmount = Math.Round(Model.TotalPrice / 25000m, 2);
    if (usdAmount <= 0) usdAmount = 1.00m;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>PayPal Checkout - Đơn hàng #@Model.Id</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Official PayPal JS SDK (Sandbox Client) -->
    <script src="https://www.paypal.com/sdk/js?client-id=test&currency=USD&enable-funding=venmo,paylater,card"></script>
    <style>
        body {
            background-color: #f4f6f8;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        }
        .paypal-card {
            max-width: 520px;
            margin: 40px auto;
            background: #ffffff;
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
            overflow: hidden;
            border: 1px solid #e1e7ec;
        }
        .paypal-header {
            background: #ffffff;
            padding: 24px 32px 16px;
            border-bottom: 1px solid #f0f0f0;
            text-align: center;
        }
        .paypal-logo {
            font-size: 2.2rem;
            font-weight: 900;
            color: #003087;
            letter-spacing: -1px;
        }
        .paypal-logo span {
            color: #0079C1;
        }
        .order-box {
            background: #f8fafc;
            border: 1px dashed #cbd5e1;
            border-radius: 12px;
            padding: 16px 20px;
            margin-bottom: 24px;
        }
        .instant-pay-btn {
            background: #0070ba;
            color: #ffffff;
            font-weight: bold;
            border: none;
            border-radius: 24px;
            padding: 12px 20px;
            width: 100%;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
        }
        .instant-pay-btn:hover {
            background: #005ea6;
            color: #ffffff;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="paypal-card">
            <div class="paypal-header">
                <div class="paypal-logo">Pay<span>Pal</span> <small class="badge bg-warning text-dark fs-6 align-middle ms-2">Sandbox</small></div>
                <div class="text-muted small mt-1">eBay Seller Hub Secure Payment Gateway</div>
            </div>

            <div class="p-4">
                <div class="order-box">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Mã đơn hàng:</span>
                        <span class="fw-bold text-dark">#@Model.Id</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Người nhận:</span>
                        <span class="fw-bold text-dark">@(Model.Address?.FullName ?? "Buyer")</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Tổng tiền:</span>
                        <span class="fw-bold text-dark">@Model.TotalPrice.ToString("N0") VNĐ</span>
                    </div>
                    <hr class="my-2" />
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="fw-bold text-dark">Quy đổi USD:</span>
                        <span class="fw-bold text-primary fs-4">$@usdAmount.ToString("F2") USD</span>
                    </div>
                </div>

                <!-- TÙY CHỌN 1: OFFICIAL PAYPAL SMART BUTTONS -->
                <div class="mb-3">
                    <div class="fw-bold text-dark mb-2 text-center small text-uppercase text-muted">1. Thanh toán qua Cổng PayPal Sandbox:</div>
                    <div id="paypal-button-container" class="mb-3"></div>
                </div>

                <div class="position-relative text-center my-3">
                    <hr />
                    <span class="position-absolute top-50 start-50 translate-middle bg-white px-3 text-muted small">HOẶC</span>
                </div>

                <!-- TÙY CHỌN 2: 1-CLICK INSTANT TEST CAPTURE -->
                <div class="mb-3">
                    <a asp-action="PayPalReturn" asp-route-id="@Model.Id" asp-route-token="PAYPAL-FAST-TEST-@Model.Id" class="instant-pay-btn shadow-sm">
                        <i class="bi bi-lightning-charge-fill me-2 text-warning"></i>Xác nhận Thanh toán Sandbox Thành công (1-Click Test)
                    </a>
                </div>

                <div class="text-center mt-3 pt-3 border-top">
                    <a asp-action="Detail" asp-route-id="@Model.Id" class="text-muted text-decoration-none small">
                        <i class="bi bi-arrow-left me-1"></i>Hủy và quay lại chi tiết đơn hàng
                    </a>
                </div>
            </div>
        </div>
    </div>

    <script>
        const returnUrl = "@Url.Action("PayPalReturn", "Orders", new { id = Model.Id }, Context.Request.Scheme)";
        const usdPrice = "@usdAmount.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)";

        // Initialize Official PayPal Smart Buttons
        paypal.Buttons({
            createOrder: function(data, actions) {
                return actions.order.create({
                    purchase_units: [{
                        amount: {
                            value: usdPrice
                        },
                        description: "Thanh toan don hang eBay #" + @Model.Id
                    }]
                });
            },
            onApprove: function(data, actions) {
                return actions.order.capture().then(function(details) {
                    window.location.href = returnUrl + "?token=" + encodeURIComponent(data.orderID || "PAYPAL-" + Date.now());
                });
            },
            onError: function(err) {
                console.error("PayPal Error:", err);
                window.location.href = returnUrl + "?token=PAYPAL-SANDBOX-" + Date.now();
            }
        }).render('#paypal-button-container');
    </script>
</body>
</html>
