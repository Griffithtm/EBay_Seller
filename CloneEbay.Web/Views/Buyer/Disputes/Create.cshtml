@{
    ViewData["Title"] = "Tạo Khiếu nại / Tranh chấp";
    var orderId = ViewBag.OrderId as int?;
}

<div class="page-breadcrumb reveal"><a asp-controller="Home" asp-action="Index">Trang chủ</a><span>›</span><a asp-action="Disputes">Khiếu nại</a><span>›</span><strong>Tạo mới</strong></div>

<section class="catalog-hero reveal">
    <div>
        <span class="section-kicker">CREATE DISPUTE</span>
        <h1>Gửi khiếu nại đơn hàng</h1>
        <p>Vui lòng mô tả rõ sự cố bạn gặp phải (hàng hư hỏng, không giống mô tả, giao thiếu...).</p>
    </div>
</section>

<section class="catalog-workspace reveal reveal-delay-1 mt-4 max-w-2xl">
    <div class="card shadow-sm border rounded-3 p-4">
        <form asp-action="CreateDispute" method="post">
            <div class="mb-3">
                <label class="form-label fw-bold">Mã Đơn hàng (#) <span class="text-danger">*</span></label>
                <input type="number" name="orderId" value="@(orderId?.ToString() ?? "")" class="form-control" placeholder="Ví dụ: 101" required />
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Mô tả lý do khiếu nại <span class="text-danger">*</span></label>
                <textarea name="description" class="form-control" rows="5" placeholder="Mô tả chi tiết nội dung sự cố bạn gặp phải với sản phẩm/đơn hàng này..." required></textarea>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-warning px-4 fw-bold">Gửi khiếu nại</button>
                <a asp-action="Disputes" class="btn btn-outline-secondary px-4">Hủy bỏ</a>
            </div>
        </form>
    </div>
</section>
