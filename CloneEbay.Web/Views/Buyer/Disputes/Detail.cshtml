@model DisputeResponseDto
@{
    ViewData["Title"] = $"Chi tiết Khiếu nại #{Model.Id}";
}

<div class="page-breadcrumb reveal"><a asp-controller="Home" asp-action="Index">Trang chủ</a><span>›</span><a asp-action="Disputes">Khiếu nại</a><span>›</span><strong>#@Model.Id</strong></div>

<section class="catalog-hero reveal">
    <div>
        <span class="section-kicker">DISPUTE DETAILS</span>
        <h1>Khiếu nại cho đơn hàng #@Model.OrderId</h1>
        <p>Ngày tạo: @Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm") | Trạng thái: <strong class="text-primary">@Model.Status</strong></p>
    </div>
</section>

<section class="catalog-workspace reveal reveal-delay-1 mt-4">
    <div class="row g-4">
        <div class="col-md-8">
            <div class="card mb-4 border">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Nội dung Khiếu nại của bạn</h5>
                </div>
                <div class="card-body">
                    <p class="card-text">@Model.Description</p>
                    @if (Model.Resolution != null)
                    {
                        <div class="alert alert-success mt-3 mb-0">
                            <strong>Kết quả xử lý từ Người bán / Admin:</strong> @Model.Resolution
                        </div>
                    }
                </div>
            </div>

            <div class="card mb-4 border">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Trao đổi trực tiếp với Người bán</h5>
                </div>
                <div class="card-body" style="max-height: 400px; overflow-y: auto;">
                    @if (Model.Messages.Count == 0)
                    {
                        <p class="text-muted text-center py-3">Chưa có tin nhắn trao đổi nào.</p>
                    }
                    else
                    {
                        foreach (var msg in Model.Messages)
                        {
                            <div class="mb-3 p-3 rounded-3 @(msg.SenderRole == "Buyer" ? "bg-primary-subtle text-end ms-5" : "bg-light me-5") border">
                                <div class="small fw-bold text-muted mb-1">
                                    @msg.SenderUsername (@msg.SenderRole) • @msg.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                </div>
                                <div>@msg.Message</div>
                            </div>
                        }
                    }
                </div>
                @if (Model.Status != "Resolved" && Model.Status != "Closed")
                {
                    <div class="card-footer bg-white">
                        <form asp-action="RespondDispute" method="post">
                            <input type="hidden" name="id" value="@Model.Id" />
                            <div class="input-group">
                                <input type="text" name="message" class="form-control" placeholder="Viết phản hồi cho người bán..." required />
                                <button type="submit" class="btn btn-primary">Gửi</button>
                            </div>
                        </form>
                    </div>
                }
            </div>
        </div>

        <div class="col-md-4">
            <div class="card mb-4 border">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Bằng chứng & Ảnh đính kèm</h5>
                </div>
                <div class="card-body">
                    @if (Model.Evidences.Count == 0)
                    {
                        <p class="text-muted small">Chưa có bằng chứng nào.</p>
                    }
                    else
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var ev in Model.Evidences)
                            {
                                <li class="list-group-item py-2 d-flex justify-content-between align-items-center">
                                    <a href="@ev.FilePath" target="_blank" class="fw-bold text-truncate" style="max-width: 200px;">📷 @ev.FileName</a>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>
    </div>
</section>
