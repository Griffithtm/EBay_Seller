@model PagedResultDto<DisputeResponseDto>
@{
    ViewData["Title"] = "Khiếu nại & Tranh chấp của tôi";
    var statusFilter = ViewBag.StatusFilter as string;
}

<div class="page-breadcrumb reveal"><a asp-controller="Home" asp-action="Index">Trang chủ</a><span>›</span><strong>Khiếu nại của tôi</strong></div>

<div id="notificationToast" class="alert alert-info alert-dismissible fade show d-none position-fixed top-0 end-0 m-3 shadow-lg" style="z-index: 9999; max-width: 350px;" role="alert">
    <strong>🔔 Cập nhật mới:</strong> <span id="toastMsg">Có cập nhật trạng thái khiếu nại!</span>
    <button type="button" class="btn-close" onclick="document.getElementById('notificationToast').classList.add('d-none')"></button>
</div>

<section class="catalog-hero reveal">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <span class="section-kicker">BUYER RESOLUTION CENTER</span>
            <h1>Khiếu nại & Tranh chấp của tôi</h1>
            <p>Theo dõi tiến độ giải quyết các đơn hàng có sự cố.</p>
        </div>
        <div>
            <a asp-action="CreateDispute" class="btn btn-warning btn-lg fw-bold">➕ Tạo khiếu nại mới</a>
        </div>
    </div>
</section>

<section class="catalog-workspace reveal reveal-delay-1 mt-4">
    <form method="get" class="d-flex align-items-center gap-2 mb-4 p-3 bg-light rounded-3 border">
        <input type="text" name="searchTerm" value="@ViewBag.SearchTerm" placeholder="Mã đơn (#1) / mô tả..." class="form-control" style="max-width: 250px;" />
        <select name="status" aria-label="Lọc trạng thái" class="form-select" style="max-width: 180px;">
            <option value="">Tất cả trạng thái</option>
            <option value="Open" selected="@(statusFilter == "Open")">Đang mở</option>
            <option value="UnderReview" selected="@(statusFilter == "UnderReview")">Đang xem xét</option>
            <option value="Escalated" selected="@(statusFilter == "Escalated")">Đã leo thang Admin</option>
            <option value="Resolved" selected="@(statusFilter == "Resolved")">Đã giải quyết</option>
            <option value="Closed" selected="@(statusFilter == "Closed")">Đã đóng</option>
        </select>
        <button type="submit" class="btn btn-primary px-4">Lọc</button>
    </form>

    <div class="table-responsive" id="tableContainer">
        <table class="table table-hover align-middle border">
            <thead class="table-light">
                <tr>
                    <th>Mã Khiếu nại</th>
                    <th>Mã Đơn hàng</th>
                    <th>Mô tả lý do</th>
                    <th>Trạng thái</th>
                    <th class="text-right">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items.Count == 0)
                {
                    <tr>
                        <td colspan="5" class="text-center py-5">
                            <span class="text-muted">Bạn chưa có khiếu nại nào.</span>
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var dispute in Model.Items)
                    {
                        <tr>
                            <td>#@dispute.Id</td>
                            <td>#@dispute.OrderId</td>
                            <td>
                                <div>@dispute.Description</div>
                                @if (dispute.Resolution != null)
                                {
                                    <div class="mt-2 p-2 bg-success-subtle border-start border-success border-3 rounded small">
                                        <strong>Kết quả:</strong> @dispute.Resolution
                                    </div>
                                }
                            </td>
                            <td>
                                <span class="badge @(dispute.Status switch { "Resolved" => "bg-success", "Escalated" => "bg-danger", "Closed" => "bg-secondary", _ => "bg-primary" })">
                                    @(dispute.Status switch {
                                        "Open" => "Đang mở",
                                        "UnderReview" => "Đang xem xét",
                                        "Escalated" => "Admin đang xử lý",
                                        "Resolved" => "Đã giải quyết",
                                        "Closed" => "Đã đóng",
                                        _ => dispute.Status
                                    })
                                </span>
                            </td>
                            <td class="text-right action-cells">
                                <a asp-action="DisputeDetail" asp-route-id="@dispute.Id" class="btn btn-outline-primary btn-sm me-1">💬 Chi tiết & Trao đổi</a>
                                @if (dispute.Status == "Open" || dispute.Status == "UnderReview")
                                {
                                    <form asp-action="CloseDispute" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@dispute.Id" />
                                        <button type="submit" class="btn btn-outline-secondary btn-sm" onclick="return confirm('Bạn có chắc chắn muốn đóng khiếu nại này?')">Đóng</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</section>

@section Scripts {
    <script>
        setInterval(() => {
            fetch(window.location.href)
                .then(res => res.text())
                .then(html => {
                    const parser = new DOMParser();
                    const doc = parser.parseFromString(html, 'text/html');
                    const newContainer = doc.getElementById('tableContainer');
                    const oldContainer = document.getElementById('tableContainer');

                    if (newContainer && oldContainer && oldContainer.innerHTML !== newContainer.innerHTML) {
                        oldContainer.innerHTML = newContainer.innerHTML;
                    }
                })
                .catch(() => {});
        }, 2000);
    </script>
}
