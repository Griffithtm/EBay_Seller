{
  "Jwt": {
    "Issuer": "CloneEbay.API",
    "Audience": "CloneEbay.Client",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 7
  },
  "Database": {
    "ApplyMigrationsAtStartup": false
  },
  "RateLimiting": {
    "ProductCreatesPerHour": 20
  },
  "Recaptcha": {
    "Enabled": false,
    "SecretKey": "",
    "MinimumScore": 0.5
  },
  "Redis": {
    "Enabled": false,
    "ConnectionString": "localhost:6379"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
