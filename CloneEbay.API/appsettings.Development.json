    "ResetDemoSellerData": false
  },
  "Cors": {
    "AllowedOrigins": [
      "https://localhost:7248",
      "http://localhost:5132"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
