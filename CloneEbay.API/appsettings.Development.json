{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=CloneEbayDB;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Database": {
    "ApplyMigrationsAtStartup": true
  },
  "Seed": {
